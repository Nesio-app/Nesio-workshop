{
  "name": "personal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run bundle:toolbox && next dev",
    "build": "npm run bundle:toolbox && next build",
    "bundle:toolbox": "mkdir -p public/adhd-flow public/fitness public/storage public/health && cp -R adhd-flow-ios/web/. public/adhd-flow/ && cp -R fitness/web/. public/fitness/ && cp -R storage-web/. public/storage/ && cp -R health-web/. public/health/",
    "report:modules": "node scripts/report-module-registry.mjs",
    "db:migrate": "node scripts/db-local.mjs migrate",
    "db:down": "node scripts/db-local.mjs down",
    "db:seed-demo": "node scripts/db-local.mjs seed-demo",
    "db:sync-artifact-records": "node scripts/db-local.mjs sync-artifact-records",
    "report:external-bridge": "node scripts/report-external-bridge.mjs --markdown",
    "db:bootstrap": "npm run db:migrate && npm run db:seed-demo && npm run db:status",
    "db:bootstrap:full": "npm run db:migrate && npm run db:seed-demo && npm run db:sync-artifact-records && npm run db:status",
    "db:status": "node scripts/db-local.mjs status",
    "db:queue": "node scripts/db-local.mjs queue",
    "db:probe": "node scripts/db-local.mjs probe",
    "db:flow": "node scripts/db-local.mjs flow",
    "test:dec-metrics-summary": "node scripts/dec-usage-metrics-summary.test.mjs",
    "test:module-entitlements": "node scripts/report-module-registry-entitlements.test.mjs",
    "test:first-launch-risk-isolation": "node scripts/precheck-first-launch-risk-isolation.test.mjs",
    "test:inventory-first-launch": "node scripts/inventory-first-launch-contract.test.mjs",
    "test:module-adapter": "node scripts/report-module-registry-module-adapter.test.mjs",
    "test:tool-data-versioning": "node scripts/report-module-registry-tool-data-versioning.test.mjs",
    "test:tool-manifest": "node scripts/tool-manifest-v0.test.mjs",
    "test:app-api-client": "node scripts/app-api-client-contract-v01.test.mjs",
    "test:launch-sku": "node scripts/report-module-registry-launch-sku.test.mjs",
    "test:permission-consent": "node scripts/report-module-registry-permission-consent.test.mjs",
    "test:feature-control": "node scripts/report-module-registry-feature-control.test.mjs",
    "test:standalone-readiness": "node scripts/report-module-registry-standalone-readiness.test.mjs",
    "test:security-incident": "node scripts/report-module-registry-security-incident.test.mjs",
    "test:module-product": "node scripts/module-product-contract-v0.test.mjs",
    "test:module-product-report": "node scripts/report-module-product-contract.test.mjs",
    "test:web-surface": "node scripts/web-surface-contract-v0.test.mjs",
    "test:web-surface-report": "node scripts/report-web-surface-contract.test.mjs",
    "test:user-identity-upgrade": "node scripts/report-module-registry-user-identity-upgrade.test.mjs",
    "test:offline-sync-conflict": "node scripts/report-module-registry-offline-sync-conflict.test.mjs",
    "test:cloud-readiness": "node scripts/report-module-registry-cloud-readiness.test.mjs",
    "test:local-data-records": "node scripts/local-data-records.test.mjs && node scripts/local-data-records-dashboard.test.mjs",
    "test:module-data-bus": "node scripts/module-data-bus.test.mjs",
    "test:hardcode-remediation": "node scripts/report-hardcode-remediation.test.mjs",
    "test:ai-proxy-boundary": "node scripts/report-ai-proxy-boundary.test.mjs",
    "test:calendar-fail-closed": "node app/api/portal/calendar/route.test.mjs",
    "test:contracts": "npm run test:module-entitlements && npm run test:module-adapter && npm run test:tool-data-versioning && npm run test:tool-manifest && npm run test:app-api-client && npm run test:launch-sku && npm run test:permission-consent && npm run test:feature-control && npm run test:standalone-readiness && npm run test:module-product && npm run test:module-product-report && npm run test:user-identity-upgrade && npm run test:offline-sync-conflict && npm run test:cloud-readiness && npm run test:local-data-records && npm run test:module-data-bus && npm run test:dec-metrics-summary && npm run test:inventory-first-launch",
    "test:security": "npm run precheck:no-real-data && npm run test:first-launch-risk-isolation && npm run test:security-incident && npm run test:hardcode-remediation && npm run test:ai-proxy-boundary && npm run test:calendar-fail-closed",
    "test:db:readonly": "npm run report:external-bridge",
    "test:precheck": "npm run precheck:no-real-data && npm run precheck:inventory-offline && npm run precheck:local-data-launch && npm run precheck:module-data-network && npm run precheck:mobile-app",
    "test:qa:static": "npm run report:modules && npm run test:contracts && npm run test:security && npm run test:precheck",
    "precheck:inventory-offline": "node scripts/precheck-inventory-offline-v01.mjs",
    "precheck:local-data-launch": "node scripts/precheck-local-data-launch-readiness.mjs",
    "precheck:module-data-network": "node scripts/precheck-module-data-network.mjs --offline",
    "precheck:mobile-app": "node scripts/precheck-mobile-app-integration.mjs",
    "precheck:no-real-data": "node scripts/precheck-no-real-data.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.575.0",
    "next": "14.2.5",
    "openai": "^6.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@vercel/node": "^5.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
