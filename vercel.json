{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/adhd-flow", "destination": "/adhd-flow/index.html" },
    { "source": "/fitness", "destination": "/fitness/index.html" },
    { "source": "/inner-shelter", "destination": "/inner-shelter/index.html" },
    { "source": "/secretary", "destination": "/secretary/index.html" },
    { "source": "/secretary/chat", "destination": "/secretary/chat.html" },
    { "source": "/secretary/group", "destination": "/secretary/group.html" }
  ]
}
