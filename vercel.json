{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/fitness/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/adhd-flow", "destination": "/adhd-flow/index.html" },
    { "source": "/adhd-flow/", "destination": "/adhd-flow/index.html" },
    { "source": "/fitness", "destination": "/fitness/index.html" },
    { "source": "/fitness/", "destination": "/fitness/index.html" },
    { "source": "/storage", "destination": "/storage/index.html" },
    { "source": "/storage/", "destination": "/storage/index.html" },
    { "source": "/health", "destination": "/health/index.html" },
    { "source": "/health/", "destination": "/health/index.html" },
    { "source": "/secretary", "destination": "/secretary/index.html" },
    { "source": "/secretary/", "destination": "/secretary/index.html" },
    { "source": "/secretary/chat", "destination": "/secretary/chat.html" },
    { "source": "/secretary/group", "destination": "/secretary/group.html" }
  ]
}
