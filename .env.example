# Optional local/internal AI sandbox only. Do not put real secrets in this file.
OPENAI_API_KEY=replace_me_local_only
GEMINI_API_KEY=replace_me_local_only

BAOHE_ENV=local
BAOHE_DB_PROVIDER=sqlite
BAOHE_DB_PATH=./database/treasurebox-local.db
BAOHE_DATABASE_URL=replace_me_server_only
BAOHE_PUBLIC_API_BASE_URL=http://localhost:3000
TREASUREBOX_MODULE_DATA_DB=true
BAOHE_DEC_RATE_LIMIT_WINDOW_MS=60000
BAOHE_DEC_RATE_LIMIT_MAX_REQUESTS=120
BAOHE_AI_PROVIDER_MODE=disabled

# Production activation v0 placeholders. Configure real values only in Vercel
# or provider consoles; never commit real secrets.
BAOHE_AUTH_ENABLED=false
BAOHE_AUTH_REDIRECT_URL=
CLOUD_DB_ENABLED=false
CLOUD_STORAGE_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_OAUTH_SCOPE=snsapi_login
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
DOUBAO_KEY=
DOUBAO_API_KEY=
ARK_API_KEY=
VOLCENGINE_API_KEY=
GOOGLE_CALENDAR_ICAL_URL=
GOOGLE_CALENDAR_ICS_URL=
GOOGLE_CALENDAR_ICAL_URLS=
FLOMO_API_KEY=

# ── 音乐模块(2026-07-30)───────────────────────────────────────────────────
# Apple Music:MusicKit developer token 在服务端用 .p8 私钥签(ES256)。
# 私钥换行写成字面量 \n 也可以,路由里会还原。三项缺一,音乐页照实显示「还没配好」。
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Spotify:遥控模型(声音由 Spotify 播),播放还需要用户是 Premium。
# 令牌只写 httpOnly cookie,不落 localStorage、不进备份、不上云。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# 网易云:自建 NeteaseCloudMusicApi 实例的地址(形如 https://xxx.example.com,不带尾斜杠)。
# 2026-07-31 更正:上一版这里写「只用来搜元数据、恒不可播」——**那是过度概括**。
# 能不能放是**逐曲**的:非独家、非 VIP 的曲子在国外出口上照样返回可播 URL。
# 所以搜索(/search)和取播放地址(/song/url)两条都走这个 base,哪一首取不到
# 由界面在点击时说「换一首」,不把整个源关掉。
#
# 这不是一个能去哪里申请的密钥,是一个**要自己跑起来的服务**:
# 找一份 NeteaseCloudMusicApi(Binaryify 的原仓已归档,fork 还有维护中的)部署到
# 自己的 VPS / 容器上,把它的对外地址填在这里。
# 红线:那个实例**必须加访问密钥或 IP 白名单**,不许裸奔在公网 —— 它能代你调网易接口。
NETEASE_API_BASE=
