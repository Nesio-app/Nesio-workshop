# Optional local/internal AI sandbox only. Do not put real secrets in this file.
OPENAI_API_KEY=replace_me_local_only
GEMINI_API_KEY=replace_me_local_only

BAOHE_ENV=local
BAOHE_DB_PROVIDER=sqlite
BAOHE_DB_PATH=./database/treasurebox-local.db
BAOHE_DATABASE_URL=replace_me_server_only
BAOHE_PUBLIC_API_BASE_URL=http://localhost:3000
TREASUREBOX_MODULE_DATA_DB=true
BAOHE_DEC_RATE_LIMIT_WINDOW_MS=60000
BAOHE_DEC_RATE_LIMIT_MAX_REQUESTS=120
BAOHE_AI_PROVIDER_MODE=disabled
