# Optional local/internal AI sandbox only. Do not put real secrets in this file.
OPENAI_API_KEY=replace_me_local_only
GEMINI_API_KEY=replace_me_local_only

BAOHE_ENV=local
BAOHE_DB_PROVIDER=sqlite
BAOHE_DB_PATH=./database/treasurebox-local.db
BAOHE_DATABASE_URL=replace_me_server_only
BAOHE_PUBLIC_API_BASE_URL=http://localhost:3000
TREASUREBOX_MODULE_DATA_DB=true
BAOHE_DEC_RATE_LIMIT_WINDOW_MS=60000
BAOHE_DEC_RATE_LIMIT_MAX_REQUESTS=120
BAOHE_AI_PROVIDER_MODE=disabled

# Production activation v0 placeholders. Configure real values only in Vercel
# or provider consoles; never commit real secrets.
BAOHE_AUTH_ENABLED=false
BAOHE_AUTH_REDIRECT_URL=
CLOUD_DB_ENABLED=false
CLOUD_STORAGE_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_OAUTH_SCOPE=snsapi_login
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
DOUBAO_KEY=
DOUBAO_API_KEY=
ARK_API_KEY=
VOLCENGINE_API_KEY=
GOOGLE_CALENDAR_ICAL_URL=
