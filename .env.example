# Optional local/internal AI sandbox only. Do not put real secrets in this file.

# ── AI 通道(2026-07-31 用户定案:Kimi 主,Google 托底)─────────────────────────
# 回退链的真源在 lib/portal/ai-provider-chain.mjs:kimi → gemini → claude → openai。
# 后两级只在配了 key 时才会被走到 —— 不配就是干净的两级链,不必改代码。
KIMI_API_KEY=replace_me_local_only
# ⚠️ **必须填,而且代码不会替你猜**。没填的话 Kimi 这一路直接抛 kimi_model_unset,
#    自动落到 Google 托底(不会静默出错)。
#    之所以不给默认值:编一个模型 ID,错了的表现是每次请求 4xx,而日志看着像 key 不对。
#    去 Moonshot 的模型列表里抄准确的那个 ID 填这儿。
KIMI_MODEL=
# 国际站(这个 App 部署在国外,默认就是它);要走国内出口再改。
KIMI_API_BASE=https://api.moonshot.ai/v1
# 成本统计用,单位:美元 / 百万 token。**不填 = /admin 把 Kimi 的花费算成 0** ——
# 那不是「免费」,是「没告诉它价格」(priceKnown() 会把这个区别透出去)。
# 同样不给默认值:随手填个差不多的数,成本页会长期给出一个看着精确、实则捏造的金额。
KIMI_PRICE_INPUT=
KIMI_PRICE_OUTPUT=

# 托底(Google)。Kimi 挂了/限流了走这里。
GEMINI_API_KEY=replace_me_local_only
# 以下两家留着但不必配 —— 配了才会进链的第三、第四级。
OPENAI_API_KEY=replace_me_local_only

BAOHE_ENV=local
BAOHE_DB_PROVIDER=sqlite
BAOHE_DB_PATH=./database/treasurebox-local.db
BAOHE_DATABASE_URL=replace_me_server_only
BAOHE_PUBLIC_API_BASE_URL=http://localhost:3000
TREASUREBOX_MODULE_DATA_DB=true
BAOHE_DEC_RATE_LIMIT_WINDOW_MS=60000
BAOHE_DEC_RATE_LIMIT_MAX_REQUESTS=120
BAOHE_AI_PROVIDER_MODE=disabled

# Production activation v0 placeholders. Configure real values only in Vercel
# or provider consoles; never commit real secrets.
BAOHE_AUTH_ENABLED=false
BAOHE_AUTH_REDIRECT_URL=
CLOUD_DB_ENABLED=false
CLOUD_STORAGE_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_OAUTH_SCOPE=snsapi_login
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
DOUBAO_KEY=
DOUBAO_API_KEY=
ARK_API_KEY=
VOLCENGINE_API_KEY=
GOOGLE_CALENDAR_ICAL_URL=
GOOGLE_CALENDAR_ICS_URL=
GOOGLE_CALENDAR_ICAL_URLS=
FLOMO_API_KEY=

# ── 音乐模块(2026-07-30)───────────────────────────────────────────────────
# Apple Music:MusicKit developer token 在服务端用 .p8 私钥签(ES256)。
# 私钥换行写成字面量 \n 也可以,路由里会还原。三项缺一,音乐页照实显示「还没配好」。
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Spotify:遥控模型(声音由 Spotify 播),播放还需要用户是 Premium。
# 令牌只写 httpOnly cookie,不落 localStorage、不进备份、不上云。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# 网易云:**留空就行,不用配**。
#
# 2026-07-31 起 Nesio 直连网易(协议在 lib/platform/music/netease-protocol),
# 跟 Nesio 一起部署,不需要任何常驻的第三方服务、不需要谁的电脑开着。
# 能不能放是**逐曲**的:非独家、非 VIP 的曲子照样返回可播 URL,
# 取不到的那些界面会说「换一首」,不把整个源关掉。
#
# 这一项保留为**可选逃生口**:直连走的是逆向协议,网易改了就会坏。
# 那时候可以自己跑一份 NeteaseCloudMusicApi,把它的对外地址填在这儿
# (形如 https://xxx.example.com,不带尾斜杠),配了就优先走它。
# 红线:那个实例**必须加访问密钥或 IP 白名单**,不许裸奔在公网 —— 它能代你调网易接口。
NETEASE_API_BASE=
