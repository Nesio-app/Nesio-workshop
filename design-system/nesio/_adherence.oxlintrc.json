{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/portal/**",
              "lib/**",
              "ui_kits/shell/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans SC|Noto Sans JP|Noto Sans KR|Noto Serif SC))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans SC, Noto Sans JP, Noto Sans KR, Noto Serif SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|tone|pill|full|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, tone, pill, full, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|risk)$/]",
        "message": "<Button> tone must be one of 'brand' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|accent|position|size|key|ref|className|style|children)$/]",
        "message": "<FloatingButton> doesn't accept that prop. Declared props: icon, label, accent, position, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingButton'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:br|bl|tr|tl)$/]",
        "message": "<FloatingButton> position must be one of 'br' | 'bl' | 'tr' | 'tl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|raised|interactive|padding|radius|children|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: tone, raised, interactive, padding, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|cool|warm|neutral)$/]",
        "message": "<GlassCard> tone must be one of 'plain' | 'cool' | 'warm' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|multiline|rows|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, multiline, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|label|saved|onSave|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: quote, label, saved, onSave, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReminderItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|text|status|action|key|ref|className|style|children)$/]",
        "message": "<ReminderItem> doesn't accept that prop. Declared props: kind, text, status, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReminderItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:go|gentle|calm|risk)$/]",
        "message": "<ReminderItem> status must be one of 'go' | 'gentle' | 'calm' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:go|gentle|calm|risk)$/]",
        "message": "<StatusBadge> status must be one of 'go' | 'gentle' | 'calm' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolModuleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|nameEn|tone|status|locked|onOpen|children|style|key|ref|className|style|children)$/]",
        "message": "<ToolModuleCard> doesn't accept that prop. Declared props: icon, name, nameEn, tone, status, locked, onOpen, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolModuleCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cool|warm|neutral)$/]",
        "message": "<ToolModuleCard> tone must be one of 'cool' | 'warm' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeatherTime'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|date|temp|condition|place|align|style|key|ref|className|style|children)$/]",
        "message": "<WeatherTime> doesn't accept that prop. Declared props: time, date, temp, condition, place, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeatherTime'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<WeatherTime> align must be one of 'right' | 'left'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
